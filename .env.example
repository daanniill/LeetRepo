PORT=8787
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leetrepo
DATABASE_SSL=false

# Register a public GitHub App with Contents: read/write, request OAuth on
# installation, expiring user tokens, no webhooks, and this callback URL:
# https://api.leetrepo.app/v1/auth/github/callback
GITHUB_APP_SLUG=your-leetrepo-app-slug
GITHUB_APP_CLIENT_ID=Iv1.example
GITHUB_APP_CLIENT_SECRET=replace-me

# Exact chrome.identity redirect URLs, comma separated. Get the production URL
# from chrome.identity.getRedirectURL("github") after the store ID is assigned.
EXTENSION_REDIRECT_URIS=https://extension-id.chromiumapp.org/github

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile

FREE_AI_DAILY_LIMIT=3
FREE_AI_MONTHLY_LIMIT=30
GLOBAL_AI_REQUESTS_PER_MINUTE=25
SESSION_TTL_DAYS=30
ALLOWED_EXTENSION_ORIGINS=chrome-extension://extension-id

