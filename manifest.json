{
  "manifest_version": 3,
  "name": "LeetRepo Lite",
  "version": "2.0.0",
  "description": "Local-first LeetCode solution sync, analytics, and study tools with user-supplied GitHub and AI tokens.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "LeetRepo Lite",
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "src/pages/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*", "https://www.leetcode.com/problems/*"],
      "js": ["src/content/language.js", "src/content/problem.js", "src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
